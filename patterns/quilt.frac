tile quad {
    sides 4
    canonical (0, 0) (1, 0) (1, 1) (0, 1)
}

partition quad.quad_split {
    edge m_s = (0.5, 0.0)
    edge m_e = (1.0, 0.5)
    edge m_n = (0.5, 1.0)
    edge m_w = (0.0, 0.5)
    interior center = (0.5, 0.5)

    cut center -- m_s
    cut center -- m_e
    cut center -- m_n
    cut center -- m_w

    child 0 = top_left
    child 1 = bottom_left
    child 2 = top_right
    child 3 = bottom_right
}

pattern {
    root quad

    state {
        r     = 0.0
        g     = 0.0
        b     = 0.0
        a     = 0.0
        blend = 1.0
        bf    = 0.0
        d     = 0.5
        p     = perm [0, 1, 2, 3]
    }

    color (r, g, b, 1.0)

    rule quad -> quad.quad_split {
        bf = 1.0 - (1.0 - blend) * a
        blend = blend * d
        slot_order = p
        child top_left {
            r = lerp(r, 1.0, bf)
            g = lerp(g, 1.0, bf)
            b = lerp(b, 1.0, bf)
            a = 1.0
            p = compose(p, perm [3, 2, 1, 0])
        }
        child top_right {
            r = lerp(r, 0.34906963, bf)
            g = lerp(g, 0.34906963, bf)
            b = lerp(b, 0.34906963, bf)
            a = 1.0
            p = compose(p, perm [2, 3, 0, 1])
        }
        child bottom_left {
            r = lerp(r, 0.0, bf)
            g = lerp(g, 0.0, bf)
            b = lerp(b, 0.0, bf)
            a = 1.0
            p = compose(p, perm [1, 0, 3, 2])
        }
        child bottom_right {
            r = lerp(r, 0.0, bf)
            g = lerp(g, 0.0, bf)
            b = lerp(b, 0.0, bf)
            a = 1.0 - bf
        }
    }
}
