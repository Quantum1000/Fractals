tile quad {
    sides 4
    canonical (0,0) (1,0) (1,1) (0,1)
}

tile tri {
    sides 3
    canonical (0,0) (1,0) (1,1)
}

partition quad.quad_split {
    edge m_s = (0.5, 0)
    edge m_e = (1, 0.5)
    edge m_n = (0.5, 1)
    edge m_w = (0, 0.5)

    cut m_s -- m_e
    cut m_e -- m_n
    cut m_n -- m_w
    cut m_w -- m_s
}

partition tri.tri_split {
    edge m_s  = (0.5, 0)
    edge m_e  = (1, 0.5)
    edge mid  = (0.5, 0.5)

    cut mid -- m_s
    cut mid -- m_e
}

pattern {
    root quad

    state {
        r      = 0.0
        g      = 0.0
        b      = 0.0
        w      = 1.0
        target = 1.0
        factor = 1.0
        decay  = 0.6
    }

    color (r, g, b, 1)

    rule quad {
        -> quad.quad_split {
            # top left tri, rotated 1/3 clockwise for some reason
            child 0 {
                r      = lerp(r, 0.5, target)
                g      = lerp(g, 0.5, target)
                b      = lerp(b, 0.5, target)
                target = factor * decay
                factor = factor * decay
            }
            # bottom left tri
            child 1 {
                r      = lerp(r, 0.6, target)
                g      = lerp(g, 0.6, target)
                b      = lerp(b, 0.0, target)
                factor = factor * decay
            }
            # center quad
            child 2 {
                r      = lerp(r, 0.0, target)
                g      = lerp(g, 0.0, target)
                b      = lerp(b, 0.0, target)
                target = lerp(target, factor * decay, 0.1)
                factor = factor * decay
            }
            # top right tri
            child 3 {
                r      = lerp(r, 0.0, target)
                g      = lerp(g, 0.0, target)
                b      = lerp(b, 0.3, target)
                target = factor * decay
                factor = factor * decay
            }
            # bottom right quad
            child 4 {
                r      = lerp(r, 0.3, target)
                g      = lerp(g, 0.2, target)
                b      = lerp(b, 0.0, target)
                target = lerp(target, factor * decay, 0.5)
                factor = factor * decay
            }
        }
    }

    rule tri {
        -> tri.tri_split {
            # tri
            child 0 {
                r      = lerp(r, 0.8, target)
                g      = lerp(g, 0.8, target)
                b      = lerp(b, 1, target)
                target = factor * decay
                factor = factor * decay
            }
            # quad
            child 1 {
                r      = lerp(r, 0.0, target)
                g      = lerp(g, 0.0, target)
                b      = lerp(b, 0.0, target)
                target = lerp(target, factor * decay, 0.1)
                factor = factor * decay
            }
            # tri, also rotated 1/3 clockwise
            child 2 {
                r      = lerp(r, 0.8, target)
                g      = lerp(g, 0.5, target)
                b      = lerp(b, 0.0, target)
                target = factor * decay
                factor = factor * decay
            }
        }
    }
}
