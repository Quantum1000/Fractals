{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "frac",
  "scopeName": "source.frac",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#declarations" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.frac",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.frac",
          "match": "\\b(tile|partition|pattern|rule|state|color|root|edge|cut|sides|canonical|symmetry|child|slot_order|alignment|fn|if|else|perm)\\b"
        },
        {
          "name": "support.function.builtin.frac",
          "match": "\\b(sin|cos|exp|sqrt|abs|log|lerp|clamp)\\b"
        },
        {
          "name": "variable.language.frac",
          "match": "\\b(pos_x|pos_y|scale|orientation|shear|stretch|depth|random)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.frac",
          "match": "\\b(none|true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.frac",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.frac",
          "match": "->|--|=>|==|!=|<=|>=|&&|\\|\\||\\?|=|<|>|\\+|-|\\*|/"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(tile|partition|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.frac" },
            "2": { "name": "entity.name.type.frac" }
          }
        },
        {
          "match": "\\b(rule)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.frac" },
            "2": { "name": "entity.name.type.frac" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.frac",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
